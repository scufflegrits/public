# Normalize all text files to LF in the repo
* text=auto

# Force Unix line endings for shell scripts (and other Unix files)
*.sh     text eol=lf
*.bash   text eol=lf
*.zsh    text eol=lf

# Optional: other files that should always be LF
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.md     text eol=lf

# Shell-sourced and script files that break with CRLF
*.bats          text eol=lf
*.bashrc        text eol=lf
*.bash_aliases  text eol=lf
bash_aliases    text eol=lf
*.py            text eol=lf
*.conf          text eol=lf
